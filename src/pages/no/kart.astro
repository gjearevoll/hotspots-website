---
import Layout from "../../layouts/Layout.astro";
import metadata from "../../data/hotspot-metadata.json";
import zenodoRecord from "../../data/zenodo-record.json";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Data tab figures come from the Zenodo record's metadata.json, refreshed by
// scripts/fetch-zenodo-data.mjs alongside the map rasters.
const step1b = metadata.step_1b;
const summary = step1b.dataset_summary;

// Modelled taxa are mapped to the map's taxa groups via the step 4a output
// groups; the pipeline's "arthropods" group is the map's "insects".
const STEP4A_TO_GROUP = { arthropods: "insects" };
const taxonToGroup = {};
const speciesByGroup = {};
for (const [step4aGroup, v] of Object.entries(metadata.step_4a)) {
  const group = STEP4A_TO_GROUP[step4aGroup] ?? step4aGroup;
  speciesByGroup[group] = {
    total: v.n_species[0],
    threatenedSpecies: v.n_subgroups_species?.threatenedSpecies?.[0],
    ansvarsArter: v.n_subgroups_species?.ansvarsArter?.[0],
  };
  for (const taxon of v.taxa) taxonToGroup[taxon] = group;
}

// dataset_summary has one row per dataset x taxon, so rows are merged per
// dataset within each group. Its field names are swapped relative to the top-level totals (a
// quirk of the pipeline's metadata writer): n_total_rec here is the
// presence-only count, and sums to step_1b.n_total_obs.
const rowsByGroup = {};
summary.dataset.forEach((name, i) => {
  const group = taxonToGroup[summary.taxa[i]];
  if (!group) return;
  const rows = (rowsByGroup[group] ??= new Map());
  const row = rows.get(name) ?? { name, observations: 0 };
  row.observations += summary.n_total_rec[i];
  rows.set(name, row);
});

const DATA_GROUP_ORDER = ["birds", "vascularPlants", "insects"];
const dataGroups = DATA_GROUP_ORDER.filter((group) => rowsByGroup[group]).map((group) => {
  const rows = [...rowsByGroup[group].values()].sort((a, b) => b.observations - a.observations);
  return {
    group,
    rows,
    maxObservations: rows[0].observations,
    stats: {
      species: speciesByGroup[group].total,
      threatenedSpecies: speciesByGroup[group].threatenedSpecies,
      ansvarsArter: speciesByGroup[group].ansvarsArter,
      observations: rows.reduce((sum, r) => sum + r.observations, 0),
      datasets: rows.length,
    },
  };
});
const DATASET_ROWS_SHOWN = 10;

// Data provenance report in the Zenodo record (null if the record has none)
const report = zenodoRecord.report;
const fmtSize = (b) => (b < 1024 * 1024 ? `${Math.round(b / 1024)} KB` : `${(b / 1024 / 1024).toFixed(1)} MB`);
const fmt = new Intl.NumberFormat("nb-NO");

const strings = {
  intro:
    "Utforsk biodiversitetskart frå Hotspot-prosjektet. Vel eit kartlag i lista for å vise det på kartet. Karta er tilgjengelege som Cloud Optimized GeoTIFF og kan lastast ned enkeltvis eller brukast direkte i GIS-programvare.",
  dataLinkPrefix: "Ei fullstendig skildring av dataproduksjonen finn du på",
  dataLinkText: "følgjande lenke",
  panelHeading: "Kartlag",
  activeHeading: "Aktivt lag",
  downloadLabel: "Last ned",
  error: "Klarte ikkje å laste kartlaget.",
  tabs: { map: "Kart", data: "Data", methods: "Metode" },
  methodsParagraphs: [
    "Observasjonane hentar vi frå GBIF og andre opne biodiversitetsdatabasar – nasjonale overvakingsprogram, naturhistoriske museumssamlingar og folkeforskingsplattformer som Artsobservasjoner, Observation.org og iNaturalist. Postane vert reinsa, taksonomisk kontrollerte og samanlikna med Norsk raudliste. Dette gjeld no fugl, karplanter og insekt.",
    "Kvar post vert kopla til eit felles sett med miljøvariablar som dekkjer heile Noreg – klima (sommartemperatur og -nedbør), terreng, arealdekke og mål på menneskeleg påverknad som avstand til vegar og busetjingstettleik – alle på same romlege oppløysing.",
    "Fordi observasjonsdataen kjem frå svært ulike kjelder – nokre systematiske, andre tilfeldige – vert artsrikdom rekna ut med ein integrert artsutbreiingsmodell (iSDM), eit bayesiansk romleg modelleringsrammeverk (bygd på R-pakkane PointedSDMs og inlabru) som kombinerer desse datatypane i éin modell per art og samstundes tek omsyn til skeivheita kvar kjelde fører med seg. Dei einskilde artsmodellane vert så sette saman til rikdoms-, skeivheits- og usikkerheitslaga som er viste på Kart-fana.",
  ],
  dataIntro:
    "Desse tala oppsummerer dataa som ligg til grunn for dei noverande karta for den valde artsgruppa: talet på modellerte artar, mellom anna kor mange som er truga (Norsk raudliste) eller ansvarsartar, og dei individuelle observasjonane og bidragsytande datasetta som står att etter at dei rå postane frå GBIF og andre kjelder er reinsa og kvalitetsfiltrerte. Fullstendige metadata for datasettet finn du i metadatarapporten nedanfor.",
  statLabels: {
    species: "Modellerte artar",
    threatenedSpecies: "Truga artar",
    ansvarsArter: "Ansvarsartar",
    observations: "Observasjonar",
    datasets: "Bidragsytande datasett",
  },
  datasetChartHeading: "Observasjonar per datasett",
  datasetChartNote: (name) =>
    `Datasett er rangerte etter observasjonar etter reinsing — ${name} står åleine for størstedelen av postane.`,
  showAllDatasetsLabel: (count) => `Vis alle ${count} datasetta`,
  showFewerDatasetsLabel: "Vis færre",
  reportHeading: "Metadatarapport",
  reportText:
    "Fullstendige metadata for dei noverande karta – datakjelder, prosesseringssteg, miljøvariablar og modelloppsett – er dokumenterte i metadatarapporten (PDF, på engelsk), som er publisert saman med datasettet på Zenodo.",
  reportViewLabel: "Vis rapport",
  uncertaintyToggle: "Vis usikkerheit",
  uncertaintyInfoLabel: "Om usikkerheit",
  uncertaintyInfo:
    "Usikkerheit er her vist på ein relativ skala per taksonomisk gruppe. Eit område med høg usikkerheit for fugl (ei gruppe vi har mykje data om) kan difor vere vesentleg mindre usikkert enn eit tilsvarande område for insekt (som vi har relativt lite data om).",
  uncertaintyLegendHeading: "Usikkerheit",
  quartileLabels: ["Middels usikkerheit", "Høg usikkerheit"],
  legendLow: "Låg",
  legendHigh: "Høg",
  filterLabels: {
    taxa: "Taksonomisk gruppe",
    group: "Artsgruppe",
    metric: "Karttype",
  },
  taxaLabels: {
    birds: "Fugl",
    vascularPlants: "Karplanter",
    insects: "Insekt",
  },
  groupLabels: {
    all: "Alle artar",
    concern: "Ansvarsartar",
    threatened: "Truga artar",
  },
  metricLabels: {
    richness: "Artsrikdom",
    bias: "Prøvetakingsskeivheit",
  },
  labels: {
    all_birds_richness: "Artsrikdom (fugl)",
    all_birds_bias: "Prøvetakingsskeivheit (fugl)",
    all_vascularPlants_richness: "Artsrikdom (karplanter)",
    all_vascularPlants_bias: "Prøvetakingsskeivheit (karplanter)",
    all_insects_richness: "Artsrikdom (insekt)",
    all_insects_bias: "Prøvetakingsskeivheit (insekt)",
    concern_birds_richness: "Ansvarsartar (fugl)",
    concern_birds_bias: "Prøvetakingsskeivheit, ansvarsartar (fugl)",
    concern_vascularPlants_richness: "Ansvarsartar (karplanter)",
    concern_vascularPlants_bias: "Prøvetakingsskeivheit, ansvarsartar (karplanter)",
    concern_insects_richness: "Ansvarsartar (insekt)",
    concern_insects_bias: "Prøvetakingsskeivheit, ansvarsartar (insekt)",
    threatened_birds_richness: "Truga artar (fugl)",
    threatened_vascularPlants_richness: "Truga artar (karplanter)",
    threatened_insects_richness: "Truga artar (insekt)",
  },
};
---

<Layout title="Utforsk" activePage="kart" lang="no">
  <div class="page-header">
    <div class="page-header-inner">
      <h1>Utforsk</h1>
      <p>Interaktive kart over biologisk mangfald i Noreg.</p>
    </div>
  </div>

  <div class="section">
    <div class="tab-nav" role="tablist">
      <button type="button" class="tab-btn active" id="tab-btn-map" data-tab="map" role="tab" aria-selected="true" aria-controls="panel-map">{strings.tabs.map}</button>
      <button type="button" class="tab-btn" id="tab-btn-data" data-tab="data" role="tab" aria-selected="false" aria-controls="panel-data">{strings.tabs.data}</button>
      <button type="button" class="tab-btn" id="tab-btn-methods" data-tab="methods" role="tab" aria-selected="false" aria-controls="panel-methods">{strings.tabs.methods}</button>
    </div>

    <div id="panel-map" class="tab-panel" role="tabpanel" aria-labelledby="tab-btn-map">
      <p class="explorer-intro">{strings.intro}</p>

      <div class="explorer">
        <aside class="layer-panel">
          <h2 class="panel-heading">{strings.panelHeading}</h2>
          <div class="filter-group">
            <div class="filter-field">
              <label for="taxa-select">{strings.filterLabels.taxa}</label>
              <select id="taxa-select"></select>
            </div>
            <div class="filter-field">
              <label for="metric-select">{strings.filterLabels.metric}</label>
              <select id="metric-select"></select>
            </div>
            <div class="filter-field" id="group-field">
              <label for="group-select">{strings.filterLabels.group}</label>
              <select id="group-select"></select>
            </div>
          </div>

          <div id="active-info" class="active-info" hidden>
            <div class="active-heading">{strings.activeHeading}</div>
            <div id="active-title" class="active-title"></div>
            <div id="legend" class="legend" hidden>
              <div id="legend-bar" class="legend-bar"></div>
              <div class="legend-range">
                <span id="legend-min"></span>
                <span id="legend-max"></span>
              </div>
            </div>
            <div id="uncertainty-toggle-wrap" class="uncertainty-row" hidden>
              <label class="uncertainty-toggle">
                <input type="checkbox" id="uncertainty-toggle" />
                <span>{strings.uncertaintyToggle}</span>
              </label>
              <div class="info-wrap">
                <button
                  type="button"
                  id="uncertainty-info-btn"
                  class="info-btn"
                  aria-label={strings.uncertaintyInfoLabel}
                  aria-expanded="false"
                >?</button>
                <div id="uncertainty-info-popup" class="info-popup" role="tooltip" hidden>
                  {strings.uncertaintyInfo}
                </div>
              </div>
            </div>
            <div id="uncertainty-legend" class="uncertainty-legend" hidden>
              <div class="uncertainty-legend-heading">{strings.uncertaintyLegendHeading}</div>
              <ul class="quartile-swatches">
                <li><span class="swatch" style="background:rgba(229,115,115,0.26)"></span>{strings.quartileLabels[0]}</li>
                <li><span class="swatch" style="background:rgba(229,115,115,0.40)"></span>{strings.quartileLabels[1]}</li>
              </ul>
            </div>
            <a id="download-link" class="download-btn" download>
              <span class="dl-icon" aria-hidden="true">📥</span>
              <span class="dl-text">
                <span class="dl-action">{strings.downloadLabel}</span>
                <span id="download-name" class="dl-name"></span>
                <span id="download-size" class="dl-size"></span>
              </span>
            </a>
          </div>
        </aside>

        <div class="map-wrap">
          <div id="map" class="map"></div>
          <div id="map-loader" class="map-loader" hidden><div class="spinner"></div></div>
          <div id="map-error" class="map-error" hidden></div>
        </div>
      </div>
    </div>

    <div id="panel-data" class="tab-panel" role="tabpanel" aria-labelledby="tab-btn-data" hidden>
      <p class="explorer-intro">{strings.dataIntro}</p>

      <div class="filter-field data-group-field">
        <label for="data-group-select">{strings.filterLabels.taxa}</label>
        <select id="data-group-select">
          {dataGroups.map(({ group }) => (
            <option value={group}>{strings.taxaLabels[group]}</option>
          ))}
        </select>
      </div>

      {dataGroups.map(({ group, rows, maxObservations, stats }, gi) => (
        <div class="data-group-panel" data-group-panel={group} hidden={gi !== 0}>
          {/* Species counts (all / threatened / ansvarsarter) from step 4a,
              then the underlying observation data on a second row */}
          <div class="stat-tiles stat-tiles-species">
            {["species", "threatenedSpecies", "ansvarsArter"].map((key) => (
              <div class="stat-tile">
                <div class="stat-value">{stats[key] === undefined ? "–" : fmt.format(stats[key])}</div>
                <div class="stat-label">{strings.statLabels[key]}</div>
              </div>
            ))}
          </div>
          <div class="stat-tiles">
            <div class="stat-tile">
              <div class="stat-value">{fmt.format(stats.observations)}</div>
              <div class="stat-label">{strings.statLabels.observations}</div>
            </div>
            <div class="stat-tile">
              <div class="stat-value">{fmt.format(stats.datasets)}</div>
              <div class="stat-label">{strings.statLabels.datasets}</div>
            </div>
          </div>

          <div class="dataset-chart">
            <h2 class="panel-heading">{strings.datasetChartHeading}</h2>
            <div class="dataset-rows">
              {rows.map((row, i) => (
                <div class={i >= DATASET_ROWS_SHOWN ? "dataset-row dataset-row-extra" : "dataset-row"} hidden={i >= DATASET_ROWS_SHOWN}>
                  <div class="dataset-row-label">
                    <span class="dataset-name">{row.name}</span>
                  </div>
                  <div class="dataset-row-bar">
                    <div class="bar-track">
                      <div class="bar-fill" style={`width:${(row.observations / maxObservations) * 100}%`}></div>
                    </div>
                    <span class="bar-value">{fmt.format(row.observations)}</span>
                  </div>
                </div>
              ))}
            </div>
            {rows.length > DATASET_ROWS_SHOWN && (
              <button type="button" class="show-all-btn" aria-expanded="false"
                data-show-all-label={strings.showAllDatasetsLabel(rows.length)}>
                {strings.showAllDatasetsLabel(rows.length)}
              </button>
            )}
            <p class="dataset-chart-note">{strings.datasetChartNote(rows[0].name)}</p>
          </div>
        </div>
      ))}

      {report && (
        <div class="report-block">
          <h2 class="panel-heading">{strings.reportHeading}</h2>
          <p class="report-text">{strings.reportText}</p>
          <div class="report-links">
            <a class="download-btn" href={report.viewUrl} target="_blank" rel="noopener">
              <span class="dl-icon" aria-hidden="true">📄</span>
              <span class="dl-text">
                <span class="dl-action">{strings.reportViewLabel}</span>
                <span class="dl-name">{report.file}</span>
              </span>
            </a>
            <a class="download-btn download-btn-outline" href={report.downloadUrl}>
              <span class="dl-icon" aria-hidden="true">📥</span>
              <span class="dl-text">
                <span class="dl-action">{strings.downloadLabel}</span>
                <span class="dl-size">PDF, {fmtSize(report.sizeBytes)}</span>
              </span>
            </a>
          </div>
        </div>
      )}
    </div>

    <div id="panel-methods" class="tab-panel" role="tabpanel" aria-labelledby="tab-btn-methods" hidden>
      {strings.methodsParagraphs.map((paragraph) => (
        <p class="explorer-intro">{paragraph}</p>
      ))}
      <p class="explorer-intro">
        {strings.dataLinkPrefix}{" "}
        <strong><a href="https://www.biorxiv.org/content/10.64898/2026.05.19.721053v1" target="_blank" rel="noopener noreferrer">{strings.dataLinkText}</a></strong>.
      </p>
    </div>
  </div>

  <link
    is:inline
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/geotiff@2.1.3/dist-browser/geotiff.js"></script>
  <script is:inline src="https://unpkg.com/georaster-layer-for-leaflet@3.10.0/dist/georaster-layer-for-leaflet.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/d3-array@3/dist/d3-array.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/d3-contour@4/dist/d3-contour.min.js"></script>

  <script is:inline define:vars={{ base, strings }}>
    (function () {
      const NORWAY_BOUNDS = [[57.5, 4.0], [71.5, 31.5]]; // [[S,W],[N,E]]
      const $ = (id) => document.getElementById(id);

      function fmtBytes(b) {
        if (!b && b !== 0) return "";
        if (b < 1024) return b + " B";
        if (b < 1024 * 1024) return (b / 1024).toFixed(1) + " KB";
        return (b / (1024 * 1024)).toFixed(1) + " MB";
      }

      // Colour ramps -----------------------------------------------------
      function lerp(a, b, t) { return Math.round(a + (b - a) * t); }
      function clamp01(t) { return t < 0 ? 0 : t > 1 ? 1 : t; }

      function rampFor(id) {
        if (id.indexOf("bias") !== -1) {
          // white -> blue
          return {
            css: "linear-gradient(to right,#ffffff,#1e5aa8)",
            fn: (t) => `rgb(${lerp(255,30,t)},${lerp(255,90,t)},${lerp(255,168,t)})`,
          };
        }
        // light green -> dark green (single hue, species/responsibility richness)
        return {
          css: "linear-gradient(to right,#e8f2eb,#1d4d2a)",
          fn: (t) => `rgb(${lerp(232,29,t)},${lerp(242,77,t)},${lerp(235,42,t)})`,
        };
      }

      // Uncertainty overlay ------------------------------------------------
      // Only the 50th-75th and 75th+ percentile bands are drawn, as actual
      // vector polygons traced around contiguous high-uncertainty regions
      // with d3-contour, rather than a per-pixel raster classification —
      // avoids the raster's grid-cell edges showing up as visible rectangles.
      function computeThresholds(data, noData) {
        const valid = [];
        for (let i = 0; i < data.length; i++) {
          const v = data[i];
          if (noData !== null && v === noData) continue;
          if (!isFinite(v)) continue;
          valid.push(v);
        }
        valid.sort((a, b) => a - b);
        const at = (p) => {
          if (valid.length === 0) return 0;
          return valid[Math.min(valid.length - 1, Math.floor(p * valid.length))];
        };
        return { medium: at(0.5), high: at(0.75) };
      }

      // d3-contour needs a plain numeric grid; nodata/NaN cells are pushed
      // far below any real threshold so they never appear inside a contour.
      function sanitizeForContour(data, noData) {
        const out = new Float64Array(data.length);
        for (let i = 0; i < data.length; i++) {
          const v = data[i];
          out[i] = (noData !== null && v === noData) || !isFinite(v) ? -1e9 : v;
        }
        return out;
      }

      // Map --------------------------------------------------------------
      const map = L.map("map", { minZoom: 3, maxZoom: 12 }).fitBounds(NORWAY_BOUNDS);
      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        attribution: "&copy; OpenStreetMap",
        maxZoom: 19,
      }).addTo(map);

      let currentLayer = null;
      let uncertaintyLayer = null;
      // Holds the fully-parsed raster for the currently loaded item, so the
      // uncertainty toggle can re-render from a different band without refetching.
      let activeRaster = null;
      // Raster the uncertainty overlay actually reads from. Usually the same
      // object as activeRaster, but bias layers have no uncertainty band of
      // their own — for those it points at the sibling "all species
      // richness" raster instead, fetched lazily and cached below.
      let uncertaintySource = null;
      // Only auto-fit the view on the first layer load — switching layers
      // afterwards should keep whatever pan/zoom the user has set.
      let hasFittedBounds = false;
      // Parsed COGs, keyed by STAC item id — avoids refetching a raster that
      // was already loaded, whether as a main layer or a borrowed
      // uncertainty source.
      const rasterCache = new Map();

      function showLoader(on) { $("map-loader").hidden = !on; }
      function showError(msg) {
        const el = $("map-error");
        el.textContent = msg;
        el.hidden = !msg;
      }

      // Colour-scale range for a band. Richness is already scaled 0-1 in the
      // published data, so it uses the true min/max. Bias still has extreme
      // outlier cells, so with capMax its max is capped at the 99th percentile
      // to stop them compressing the rest of the map into the low end of the ramp.
      function statsFor(data, noData, capMax) {
        let min = Infinity;
        const valid = [];
        for (let i = 0; i < data.length; i++) {
          const v = data[i];
          if (noData !== null && v === noData) continue;
          if (!isFinite(v)) continue;
          if (v < min) min = v;
          valid.push(v);
        }
        if (!isFinite(min)) return { min: 0, max: 1, range: 1 };
        valid.sort((a, b) => a - b);
        const max = capMax
          ? valid[Math.min(valid.length - 1, Math.floor(0.99 * valid.length))]
          : valid[valid.length - 1];
        return { min, max, range: (max - min) || 1 };
      }

      function toRows(data, width, height) {
        const band = new Array(height);
        for (let r = 0; r < height; r++) {
          band[r] = data.subarray(r * width, (r + 1) * width);
        }
        return band;
      }

      // Fetches and fully parses a STAC item's COG, caching the result by
      // item id so it's only ever downloaded once per session.
      async function fetchRaster(item) {
        if (rasterCache.has(item.id)) return rasterCache.get(item.id);

        const asset = item.assets.data;
        const url = new URL(asset.href, item._self).href;
        const resp = await fetch(url);
        if (!resp.ok) throw new Error("HTTP " + resp.status);
        const buf = await resp.arrayBuffer();
        const sizeBytes = buf.byteLength;

        // Read the COG fully into memory on the main thread (no web worker)
        // so the map layer renders from memory and never re-fetches the file.
        const tiff = await GeoTIFF.fromArrayBuffer(buf);
        const image = await tiff.getImage();
        const width = image.getWidth();
        const height = image.getHeight();
        const [xmin, ymin, xmax, ymax] = image.getBoundingBox();
        let noData = image.getGDALNoData();
        if (noData === undefined) noData = null;
        const bandsData = await image.readRasters();

        const bandMap = (item.properties && item.properties.bands) || { mean: 0 };
        const label = strings.labels[item.id] || (item.properties && item.properties.title) || item.id;

        const raster = {
          width, height, xmin, xmax, ymin, ymax, noData, bandsData, bandMap,
          itemId: item.id, label, url,
          fileName: asset.href.split("/").pop(),
          sizeBytes,
        };
        rasterCache.set(item.id, raster);
        return raster;
      }

      // Every item (richness or bias) carries its own paired uncertainty
      // band for its taxon, so the source is always the item's own raster.
      async function findUncertaintySource(item, raster) {
        return raster.bandMap.uncertainty !== undefined ? raster : null;
      }

      // Renders the mean/base band of the currently loaded item from the
      // cached activeRaster, without re-fetching the file.
      function renderMean() {
        if (!activeRaster) return;
        const bandIndex = activeRaster.bandMap.mean;
        if (bandIndex === undefined) return;

        const { width, height, xmin, xmax, ymin, ymax, noData, bandsData, itemId, label } = activeRaster;
        const data = bandsData[bandIndex];
        const capMax = parseItemId(itemId)?.metric !== "richness";
        const { min, max, range } = statsFor(data, noData, capMax);
        const rows = toRows(data, width, height);

        const georaster = {
          values: [rows],
          height, width,
          pixelHeight: (ymax - ymin) / height,
          pixelWidth: (xmax - xmin) / width,
          xmin, xmax, ymin, ymax,
          noDataValue: noData,
          projection: 4326,
          numberOfRasters: 1,
          mins: [min], maxs: [max], ranges: [range],
        };
        const ramp = rampFor(itemId);

        if (currentLayer) { map.removeLayer(currentLayer); currentLayer = null; }

        currentLayer = new GeoRasterLayer({
          georaster,
          opacity: 0.85,
          resolution: 256,
          pixelValuesToColorFn: (values) => {
            const v = values[0];
            if (v === null || v === undefined || isNaN(v)) return null;
            if (noData !== null && noData !== undefined && v === noData) return null;
            return ramp.fn(clamp01((v - min) / range));
          },
        });
        currentLayer.addTo(map);
        if (!hasFittedBounds) {
          map.fitBounds(currentLayer.getBounds());
          hasFittedBounds = true;
        }

        $("active-title").textContent = label;
        $("legend-bar").style.background = ramp.css;
        $("legend-min").textContent = strings.legendLow;
        $("legend-max").textContent = strings.legendHigh;
        $("legend").hidden = false;
      }

      // Adds the uncertainty band as a semi-transparent, percentile-banded
      // overlay on top of the currently rendered richness layer.
      function renderUncertaintyOverlay() {
        if (!uncertaintySource) return;
        const bandIndex = uncertaintySource.bandMap.uncertainty;
        if (bandIndex === undefined) return;

        const { width, height, xmin, xmax, ymin, ymax, noData, bandsData } = uncertaintySource;
        const data = bandsData[bandIndex];
        const { medium, high } = computeThresholds(data, noData);
        const sanitized = sanitizeForContour(data, noData);

        const contourGen = d3.contours().size([width, height]);
        const mediumBand = contourGen.contour(sanitized, medium);
        const highBand = contourGen.contour(sanitized, high);

        // Grid indices -> lat/lng, using the raster's own bounding box.
        const coordsToLatLng = ([x, y]) => L.latLng(
          ymax - (y / height) * (ymax - ymin),
          xmin + (x / width) * (xmax - xmin)
        );
        const polygonLayer = (geometry, fillOpacity) => L.geoJSON(
          { type: "Feature", geometry, properties: {} },
          {
            coordsToLatLng,
            style: { stroke: false, fillColor: "#e57373", fillOpacity, fillRule: "evenodd", interactive: false },
          }
        );

        removeUncertaintyOverlay();

        // Draw the medium band first, then the (nested) high band on top —
        // the overlap naturally reads as a darker red, no polygon
        // subtraction needed since the high-band area is a subset.
        uncertaintyLayer = L.layerGroup([
          polygonLayer(mediumBand, 0.26),
          polygonLayer(highBand, 0.40),
        ]);
        uncertaintyLayer.addTo(map);
      }

      function removeUncertaintyOverlay() {
        if (uncertaintyLayer) { map.removeLayer(uncertaintyLayer); uncertaintyLayer = null; }
      }

      // Layer filters (taxa / species group / metric) ---------------------
      // Item ids follow the pattern "{group}_{taxa}_{metric}", e.g.
      // "all_birds_richness" or "concern_insects_bias". Parsing that
      // pattern lets the three dropdowns be built from whatever items the
      // catalog actually contains, so new taxa/metrics show up on their own.
      function parseItemId(id) {
        const m = /^(all|concern|threatened)_(.+)_(richness|bias)$/.exec(id);
        if (!m) return null;
        return { group: m[1], taxa: m[2], metric: m[3] };
      }

      const METRIC_ORDER = ["richness", "bias"];
      const GROUP_ORDER = ["all", "concern", "threatened"];

      let itemsIndex = new Map();
      let taxaOrder = [];
      const sel = { taxa: null, metric: null, group: null };

      function indexKey(taxa, metric, group) { return taxa + "|" + metric + "|" + group; }

      function buildIndex(items) {
        itemsIndex = new Map();
        taxaOrder = [];
        items.forEach((item) => {
          const parsed = parseItemId(item.id);
          if (!parsed) return;
          itemsIndex.set(indexKey(parsed.taxa, parsed.metric, parsed.group), item);
          if (taxaOrder.indexOf(parsed.taxa) === -1) taxaOrder.push(parsed.taxa);
        });
      }

      function metricsForTaxa(taxa) {
        return METRIC_ORDER.filter((metric) =>
          GROUP_ORDER.some((group) => itemsIndex.has(indexKey(taxa, metric, group)))
        );
      }

      function groupsForTaxaMetric(taxa, metric) {
        return GROUP_ORDER.filter((group) => itemsIndex.has(indexKey(taxa, metric, group)));
      }

      // Fills a <select> with the given values, preferring `current` if it's
      // still a valid option, and returns whichever value ended up selected.
      function fillSelect(selectEl, options, labels, current) {
        selectEl.innerHTML = "";
        options.forEach((value) => {
          const opt = document.createElement("option");
          opt.value = value;
          opt.textContent = labels[value] || value;
          selectEl.appendChild(opt);
        });
        const value = options.indexOf(current) !== -1 ? current : options[0];
        selectEl.value = value;
        return value;
      }

      // Rebuilds the metric options for sel.taxa, then the group options for
      // the resulting metric — a species group split doesn't exist for every
      // metric (e.g. bias), so the group field hides itself when there's
      // only one option. Bias is also forced to the "all" item even though
      // the catalog carries a duplicate "concern" one, since sampling bias
      // doesn't actually differ between species groups.
      function refreshMetricAndGroup(preferredMetric, preferredGroup) {
        const metrics = metricsForTaxa(sel.taxa);
        sel.metric = fillSelect($("metric-select"), metrics, strings.metricLabels, preferredMetric);

        const groups = groupsForTaxaMetric(sel.taxa, sel.metric);
        const groupHasNoEffect = sel.metric === "bias";
        sel.group = fillSelect($("group-select"), groups, strings.groupLabels, groupHasNoEffect ? "all" : preferredGroup);
        $("group-field").hidden = groups.length < 2 || groupHasNoEffect;
      }

      function applySelection() {
        const item = itemsIndex.get(indexKey(sel.taxa, sel.metric, sel.group));
        if (item) loadItem(item);
      }

      async function loadItem(item) {
        showError("");
        showLoader(true);
        const toggle = $("uncertainty-toggle");
        const toggleWrap = $("uncertainty-toggle-wrap");
        const wasShowingUncertainty = toggle.checked;
        try {
          const raster = await fetchRaster(item);
          activeRaster = raster;
          uncertaintySource = await findUncertaintySource(item, raster);

          toggleWrap.hidden = !uncertaintySource;
          removeUncertaintyOverlay();

          // Carries the toggle across a taxa/group switch instead of always
          // resetting it, so uncertainty stays visible while browsing.
          toggle.checked = wasShowingUncertainty && !!uncertaintySource;
          if (toggle.checked) {
            renderUncertaintyOverlay();
            $("uncertainty-legend").hidden = false;
          } else {
            $("uncertainty-legend").hidden = true;
          }

          renderMean();

          const dl = $("download-link");
          dl.href = raster.url;
          dl.setAttribute("download", raster.fileName);
          $("download-name").textContent = raster.fileName;
          $("download-size").textContent = fmtBytes(raster.sizeBytes);
          $("active-info").hidden = false;
        } catch (err) {
          console.error("Layer load failed:", err);
          showError(strings.error);
        } finally {
          showLoader(false);
        }
      }

      $("taxa-select").addEventListener("change", (e) => {
        sel.taxa = e.target.value;
        refreshMetricAndGroup(sel.metric, sel.group);
        applySelection();
      });
      $("metric-select").addEventListener("change", (e) => {
        refreshMetricAndGroup(e.target.value, sel.group);
        applySelection();
      });
      $("group-select").addEventListener("change", (e) => {
        sel.group = e.target.value;
        applySelection();
      });

      // Info popup for the uncertainty toggle ------------------------------
      (() => {
        const infoBtn = $("uncertainty-info-btn");
        const infoPopup = $("uncertainty-info-popup");

        function closePopup() {
          infoPopup.hidden = true;
          infoBtn.setAttribute("aria-expanded", "false");
        }

        infoBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          const wasHidden = infoPopup.hidden;
          infoPopup.hidden = !wasHidden;
          infoBtn.setAttribute("aria-expanded", String(wasHidden));
        });
        document.addEventListener("click", (e) => {
          if (!infoPopup.hidden && !infoPopup.contains(e.target) && e.target !== infoBtn) closePopup();
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && !infoPopup.hidden) closePopup();
        });
      })();

      $("uncertainty-toggle").addEventListener("change", (e) => {
        if (e.target.checked) {
          renderUncertaintyOverlay();
          $("uncertainty-legend").hidden = false;
        } else {
          removeUncertaintyOverlay();
          $("uncertainty-legend").hidden = true;
        }
      });

      // Map / Data / Methods tabs --------------------------------------------
      const TAB_NAMES = ["map", "data", "methods"];
      function setActiveTab(tab) {
        TAB_NAMES.forEach((name) => {
          const isActive = name === tab;
          $("panel-" + name).hidden = !isActive;
          $("tab-btn-" + name).classList.toggle("active", isActive);
          $("tab-btn-" + name).setAttribute("aria-selected", String(isActive));
        });
        // Leaflet needs a nudge after its container was hidden/reshown, or
        // tiles render at the wrong size until the next pan/zoom.
        if (tab === "map") map.invalidateSize();
      }
      TAB_NAMES.forEach((name) => {
        $("tab-btn-" + name).addEventListener("click", () => setActiveTab(name));
      });

      // Data tab: one panel per taxa group ---------------------------------
      $("data-group-select").addEventListener("change", (e) => {
        const group = e.target.value;
        document.querySelectorAll("[data-group-panel]").forEach((el) => {
          el.hidden = el.dataset.groupPanel !== group;
        });
      });

      // Data tab: expand a dataset bar chart beyond the top 10. Each button
      // carries its own "show all N" label, since N differs per group.
      document.querySelectorAll(".show-all-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const expanded = btn.getAttribute("aria-expanded") === "true";
          btn.closest(".dataset-chart").querySelectorAll(".dataset-row-extra").forEach((row) => {
            row.hidden = expanded;
          });
          btn.setAttribute("aria-expanded", String(!expanded));
          btn.textContent = expanded ? btn.dataset.showAllLabel : strings.showFewerDatasetsLabel;
        });
      });

      async function init() {
        try {
          const catUrl = new URL(base + "/stac/catalog.json", location.origin).href;
          const cat = await (await fetch(catUrl)).json();
          const child = cat.links.find((l) => l.rel === "child");
          const colUrl = new URL(child.href, catUrl).href;
          const col = await (await fetch(colUrl)).json();
          const itemLinks = col.links.filter((l) => l.rel === "item");

          const items = [];
          for (const il of itemLinks) {
            const itemUrl = new URL(il.href, colUrl).href;
            const item = await (await fetch(itemUrl)).json();
            item._self = itemUrl;
            items.push(item);
          }
          buildIndex(items);
          if (!taxaOrder.length) throw new Error("No recognised layers in catalog");
          sel.taxa = fillSelect($("taxa-select"), taxaOrder, strings.taxaLabels, taxaOrder[0]);
          refreshMetricAndGroup("richness", "all");
          applySelection();
        } catch (err) {
          console.error("Catalog load failed:", err);
          showError(strings.error);
        }
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
      } else {
        init();
      }
    })();
  </script>
</Layout>

